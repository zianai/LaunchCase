LAUNCHCASE_DATA_DIR=.launchcase
LAUNCHCASE_DATABASE_URL=sqlite:///.launchcase/launchcase.db
LAUNCHCASE_CREATIVE_ENGINE_MODE=mock
# HTTP integration requires an explicitly configured loopback Engine and token.
# LAUNCHCASE_CREATIVE_ENGINE_URL=http://127.0.0.1:4311
# LAUNCHCASE_CREATIVE_ENGINE_TOKEN=
# Tokens never go to browser code. Provision identities with launchcase auth create.
# LAUNCHCASE_TOKEN=
# LAUNCHCASE_API_URL=http://127.0.0.1:8810
