# Controlled single-host E1 only. Create a NEW private data directory first.
# Store the completed operator environment outside Git with restrictive permissions.
LAUNCHCASE_DATA_DIR=/absolute/new/private/launchcase
LAUNCHCASE_DATABASE_URL=sqlite:////absolute/new/private/launchcase/launchcase.db
LAUNCHCASE_CREATIVE_ENGINE_MODE=mock
LAUNCHCASE_API_URL=http://127.0.0.1:8815
LAUNCHCASE_RESEARCH_MODE=fake
OPENAI_AGENTS_DISABLE_TRACING=1
OTEL_SDK_DISABLED=true
NEXT_TELEMETRY_DISABLED=1
ALLOW_TEST_LIVE=off
# For isolated CE HTTP only: set MODE=http and an independently generated
# LAUNCHCASE_CREATIVE_ENGINE_TOKEN via the operator secret store, not this file.
# LAUNCHCASE_CREATIVE_ENGINE_URL=http://127.0.0.1:4310
